# CrossBorder SafeGuard Configuration
# Database
DATABASE_URL="sqlite:///./crossborder_safeguard.db"

# LLM Provider (Aliyun DashScope)
DASHSCOPE_API_KEY=""

# Security & Authentication
SECRET_KEY=""
AES_SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Rate Limiting & Fail-Closed
RATE_LIMIT_PER_MINUTE="10"
FAIL_CLOSED_ENABLED="true"

# Offline / Replay Mode
OFFLINE_MODE="false"
